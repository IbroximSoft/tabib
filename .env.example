# Supabase loyihangizdagi Settings -> API bo'limidan oling.
# Bu faylni nusxalab ".env" nomi bilan saqlang va qiymatlarni yozing.
# .env fayli hech qachon git ga tushmasligi kerak.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Xodimlar telefon raqami bilan kiradi, Supabase Auth esa pochta manzili
# talab qiladi. Shuning uchun raqam ichki manzilga aylantiriladi:
#   +998 90 123 45 67  ->  998901234567@<VITE_LOGIN_DOMEN>
#
# DIQQAT: bu domen BIR MARTA tanlanadi va keyin HECH QACHON
# o'zgartirilmaydi — aks holda barcha xodimlarning login manzili
# o'zgarib, hech kim tizimga kira olmay qoladi.
# Bu yerga haqiqiy pochta serveri kerak emas: xat yuborilmaydi.
VITE_LOGIN_DOMEN=muhiddintabib.uz
